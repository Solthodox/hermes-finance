# Hermes Finance credentials.
# Fill values manually. Copy to .env and fill only the credentials you want hermes-finance to use.
# Provider keys
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=

# Research/data MCPs
# FIRECRAWL_API_KEY=
# EXA_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# COINGECKO_DEMO_API_KEY=
# COINGECKO_PRO_API_KEY=

# Direct trading MCPs; live-fire once enabled in config.yaml.
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER=
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_ACCOUNT_ADDRESS=
# HYPERLIQUID_TESTNET=false
# HYPERLIQUID_VAULT_ADDRESS=
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true

# Obsidian access should go through the finance vault filesystem MCP.
# If your environment already provides Nexus MCP, prefer that path instead of a separate Obsidian REST MCP.

# Optional Hermes Finance Telegram gateway / local `tg` helper.
# Do not copy these from ~/.hermes unless you intentionally want shared Telegram identity.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_CHAT_ID=
# TELEGRAM_HOME_CHANNEL_NAME=
